#!/bin/bash
# Started by LoxBerry as root at boot (copied to $LBHOMEDIR/system/daemons/plugins/)
# LBHOMEDIR comes from /etc/environment; fallback: three levels above this script.
LBHOMEDIR="${LBHOMEDIR:-$(cd "$(dirname "$(readlink -f "$0")")/../../.." && pwd)}"
PDIR="REPLACELBPPLUGINDIR"
rm -f "$LBHOMEDIR/data/plugins/$PDIR/stopped.flag"
su loxberry -s /bin/bash -c "LBHOMEDIR='$LBHOMEDIR' '$LBHOMEDIR/bin/plugins/$PDIR/service.sh' start" &
exit 0
