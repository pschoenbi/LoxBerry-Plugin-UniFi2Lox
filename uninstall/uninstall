#!/bin/bash
# Runs as root before the plugin is removed
if [ -n "$LBHOMEDIR" ] && [ -f "$LBHOMEDIR/bin/plugins/REPLACELBPPLUGINDIR/https_manager.py" ]; then
    python3 "$LBHOMEDIR/bin/plugins/REPLACELBPPLUGINDIR/https_manager.py" stop >/dev/null 2>&1
fi
pkill -f "bin/plugins/REPLACELBPPLUGINDIR/go2rtc" 2>/dev/null
rm -f /dev/shm/unifi2lox_* 2>/dev/null
exit 0
